{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casaitalia-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "casaitalia",
      "database_id": "36030f97-d309-40fc-98e8-4708fe2b511f"
    }
  ],
  // Public values only. Secrets are NOT written here (this file is in git): set them once with
  //   npx wrangler secret put INTERNAL_API_SECRET
  //   npx wrangler secret put UPSTASH_REDIS_REST_TOKEN
  //   npx wrangler secret put ODOO_SYNC_SECRET      (same value as the Shared Secret in Odoo)
  "vars": {
    "NEXT_PUBLIC_WEBSITE_URL": "https://casaitaliarestaurants.com",
    "NEXT_PUBLIC_CLOUD_SYSTEM_URL": "https://systemcinpos.casaitaliarestaurants.com",
    "NEXT_PUBLIC_CDN_URL": "https://cdn.casaitaliarestaurants.com",
    "UPSTASH_REDIS_REST_URL": "https://delicate-boxer-70813.upstash.io",
    "RESERVATION_CAPACITY": "50",
    "DELIVERY_HOURS": "12:00-23:00"
  },
  "observability": {
    "enabled": true
  }
}
