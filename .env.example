# =========================================================================
# Casa Italia Customer Website - Production Environment Configuration
# =========================================================================

# Cloudflare Account & D1 Credentials
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_D1_DATABASE_ID="your_d1_database_id"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"

# Upstash Redis (For distributed rate limiting & abuse prevention)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# Service & CDN URLs
NEXT_PUBLIC_WEBSITE_URL="http://localhost:3000"
NEXT_PUBLIC_CLOUD_SYSTEM_URL="http://localhost:3001"
NEXT_PUBLIC_CDN_URL="https://cdn.casaitaliarestaurants.com"

# Internal Security Secrets (Shared with Cloud System for Cache Purging)
INTERNAL_API_SECRET="your_secure_internal_api_secret"

# Restaurant Odoo: the same value as Settings > Website > Shared Secret in Odoo (at least 24 characters).
# Odoo collects the online orders and table bookings with it (GET /api/odoo/pending, POST /api/odoo/ack).
ODOO_SYNC_SECRET="your_odoo_shared_secret"

# Guests that online bookings may seat at the same time (optional, default 50)
RESERVATION_CAPACITY="50"

# Hours (Cairo time) when delivery orders are accepted: first order - last order (optional)
DELIVERY_HOURS="12:00-23:00"



